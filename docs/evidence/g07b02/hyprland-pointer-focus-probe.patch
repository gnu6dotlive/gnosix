@@ -411,6 +419,21 @@ void CLayerSurface::onCommit() {
     g_pHyprRenderer->damageSurface(m_wlSurface->resource(), m_position.x, m_position.y);
 
     updateSurfaceScaleTransformDetails();
+
+    // G07B02 probe: input changes under a stationary pointer must update
+    // compositor pointer focus even without a physical motion event.
+    // Restrict the synthetic recomputation to actual membership transitions:
+    // the GPUI client republishes the same region on many render frames.
+    if (m_layerSurface->m_surface->m_current.updated.bits.input) {
+        auto REGION = m_layerSurface->m_surface->m_current.effectiveInputRegion();
+        if (m_hasCommittedInputRegion) {
+            const auto POINTERLOCAL = g_pInputManager->getMouseCoordsInternal() - (m_position + PMONITOR->m_position);
+            if (m_lastCommittedInputRegion.containsPoint(POINTERLOCAL) != REGION.containsPoint(POINTERLOCAL))
+                g_pInputManager->simulateMouseMovement();
+        }
+        m_lastCommittedInputRegion = std::move(REGION);
+        m_hasCommittedInputRegion = true;
+    }
 }
 
